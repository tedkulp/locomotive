# Copy to .env (compose reads it). Every value here is deployment-specific.
LOCOMOTIVE_REPO_URL=https://git.example.com/you/infra.git
# LOCOMOTIVE_REPO_USERNAME=git
# LOCOMOTIVE_REPO_TOKEN=
# LOCOMOTIVE_DEFAULT_BRANCH=main
# LOCOMOTIVE_HIDDEN_PLAYBOOKS=a.yml,b.yml
# LOCOMOTIVE_WORKING_COPY_PATH=
# Access guard (fails closed): only these peers may connect (addresses or CIDRs), and only
# allowlisted identities in this header get past the UI/API (/mcp uses bearer tokens instead).
LOCOMOTIVE_TRUSTED_PROXY_IPS=
LOCOMOTIVE_IDENTITY_HEADER=
LOCOMOTIVE_ALLOWLIST=
# LOCOMOTIVE_NTFY_URL=
# LOCOMOTIVE_NTFY_TOPIC=
# LOCOMOTIVE_NTFY_TOKEN=
# LOCOMOTIVE_HEALTHCHECKS_URL=
# Schedules' cron time zone (IANA name); unset: TZ, then /etc/localtime, then UTC.
# LOCOMOTIVE_TIME_ZONE=America/New_York
# compose only:
# LOCOMOTIVE_BIND=127.0.0.1
# LOCOMOTIVE_HOST_PORT=8000
# LOCOMOTIVE_DATA_PATH=./data
